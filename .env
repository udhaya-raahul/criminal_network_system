# Docker Compose environment. Copy this file to .env before starting the stack.
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-unique-neo4j-password
POSTGRES_USER=criminal_app
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
POSTGRES_DB=criminal_network
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
ENVIRONMENT=development
DEBUG=true
